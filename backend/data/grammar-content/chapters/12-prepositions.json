        {
          "prep": "Under",
          "meaning": "below; directly beneath",
          "example": "Your toys are under the cot."
        },
        {
          "prep": "In",
          "meaning": "enclosed space; months/years/times of day",
          "example": "There are many animals in this zoo. In the morning."
        },
        {
          "prep": "Beside",
          "meaning": "next to / at the side of",
          "example": "Dipti sits beside me in class."
        },
        {
          "prep": "Near",
          "meaning": "close to",
          "example": "Our shop is near the bus station."
        },
        {
          "prep": "Behind",
          "meaning": "at the back of",
          "example": "There is a cockroach behind the refrigerator."
        },
        {
          "prep": "In front of",
          "meaning": "facing; before",
          "example": "Khyati sits in front of me."
        },
        {
          "prep": "Between",
          "meaning": "in the middle of two things/people",
          "example": "I shall come between 5 and 6 o'clock."
        },
        {
          "prep": "Among",
          "meaning": "in the middle of more than two",
          "example": "There is a small village among the mountains."
        },
        {
          "prep": "Of",
          "meaning": "belonging to; part of",
          "example": "The Prime Minister of India."
        },
        {
          "prep": "For",
          "meaning": "duration; purpose; benefit",
          "example": "Raju has been ill for eight days."
        },
        {
          "prep": "From",
          "meaning": "origin; starting point",
          "example": "My brother came from Bharuch."
        },
        {
          "prep": "To",
          "meaning": "destination; receiver",
          "example": "We sometimes go to Aji Dam."
        },
        {
          "prep": "At",
          "meaning": "exact time; precise place",
          "example": "I got to school at 7 AM."
        },
        {
          "prep": "By",
          "meaning": "agent; mode of transport; deadline",
          "example": "We shall reach by 6 PM. Travel by bus."
        },
        {
          "prep": "With",
          "meaning": "accompaniment; instrument",
          "example": "I always write with a ball pen."
        },
        {
          "prep": "Without",
          "meaning": "absence/lack of",
          "example": "My grandfather does not walk without a stick."
        },
        {
          "prep": "Before",
          "meaning": "earlier than; in front of",
