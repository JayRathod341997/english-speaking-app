    {
      "block": "rules",
      "id": "ch-09-to-have/exp-3",
      "title": {
        "en": "Questions and negatives with 'to have'",
        "gu": "'to have' સાથેના પ્રશ્નો અને નકારાત્મક",
        "guMT": true
      },
      "items": [
        {
          "text": {
            "en": "To ask a question, move have/has/had to the front.",
            "gu": "પ્રશ્ન પૂછવા માટે, have/has/had ને આગળની તરફ ખસેડો.",
            "guMT": true
          },
          "examples": [
            {
              "en": "You have a scooter. → Have you a scooter?",
              "gu": "તમારી પાસે સ્કૂટર છે. → તમારી પાસે સ્કૂટર છે?",
              "guMT": true
            },
            {
              "en": "Pintu had a cigarette. → Had Pintu a cigarette?",
              "gu": "પિન્ટુ પાસે સિગારેટ હતી. → પિન્ટુ પાસે સિગારેટ હતી?",
              "guMT": true
            }
          ]
        },
        {
          "text": {
            "en": "To make a negative, add 'not' after have/has/had.",
            "gu": "નેગેટિવ બનાવવા માટે, have/has/haed પછી 'not' ઉમેરો.",
            "guMT": true
          },
          "examples": [
            {
              "en": "I have a red pen. → I have not a red pen.",
              "gu": "મારી પાસે લાલ પેન છે. → મારી પાસે લાલ પેન નથી.",
              "guMT": true
            },
            {
              "en": "He had an umbrella. → He had not an umbrella.",
              "gu": "તેની પાસે છત્રી હતી. → તેની પાસે છત્રી નહોતી.",
              "guMT": true
            }
          ]
        }
      ]
    },
    {
      "block": "examples",
      "id": "ch-09-to-have/exp-4",
      "items": [
        {
          "en": "I have a wrist watch.",
          "gu": "મારી પાસે કાંડા ઘડિયાળ છે.",
          "guMT": true
        },
        {
          "en": "He has a new bicycle.",
