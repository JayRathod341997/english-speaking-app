      "items": [
        {
          "text": {
            "en": "Masculine — names a male person or animal.",
            "gu": "પુરૂષવાચી - પુરૂષ વ્યક્તિ અથવા પ્રાણીના નામ.",
            "guMT": true
          },
          "examples": [
            {
              "en": "boy, tiger, poet, gentleman, horse, drake",
              "gu": "છોકરો, વાઘ, કવિ, સજ્જન, ઘોડો, ડ્રેક",
              "guMT": true
            }
          ]
        },
        {
          "text": {
            "en": "Feminine — names a female person or animal.",
            "gu": "સ્ત્રીની - સ્ત્રી વ્યક્તિ અથવા પ્રાણીના નામ.",
            "guMT": true
          },
          "examples": [
            {
              "en": "girl, tigress, poetess, lady, mare, duck",
              "gu": "છોકરી, વાઘણ, કવિતા, સ્ત્રી, ઘોડી, બતક",
              "guMT": true
            }
          ]
        },
        {
          "text": {
            "en": "Neutral — names a thing that is neither male nor female.",
            "gu": "તટસ્થ — એવી વસ્તુને નામ આપે છે જે ન તો પુરુષ હોય કે ન સ્ત્રી.",
            "guMT": true
          },
          "examples": [
            {
              "en": "book, table, bottle, computer, box",
