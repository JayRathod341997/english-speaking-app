    {
      "block": "rules",
      "id": "ch-04-gender/exp-3",
      "title": {
        "en": "Forming feminine by adding a suffix",
        "gu": "પ્રત્યય ઉમેરીને સ્ત્રીલિંગ બનાવવું",
        "guMT": true
      },
      "items": [
        {
          "text": {
            "en": "The most common suffix is -ess, added to the masculine form. Sometimes the masculine ending is modified first.",
            "gu": "સૌથી સામાન્ય પ્રત્યય છે -ess, પુરૂષવાચી સ્વરૂપમાં ઉમેરવામાં આવે છે. કેટલીકવાર પુરૂષવાચી અંત પહેલા ફેરફાર કરવામાં આવે છે.",
            "guMT": true
          },
          "examples": [
            {
              "en": "poet → poetess; lion → lioness; tiger → tigress; leopard → leopardess; host → hostess; giant → giantess; god → goddess; actor → actress; master → mistress; hunter → huntress; enchanter → enchantress",
              "gu": "કવિ → કવિયત્રી; સિંહ → સિંહણ; વાઘ → વાઘણ; ચિત્તો → ચિત્તો; યજમાન → પરિચારિકા; વિશાળ → જાયન્ટેસ; દેવ → દેવી; અભિનેતા → અભિનેત્રી; માસ્ટર → રખાત; શિકારી → શિકારી; જાદુગર → જાદુગર",
              "guMT": true
            }
          ]
        },
        {
          "text": {
            "en": "A few masculines use the suffix -ette or other suffixes.",
            "gu": "થોડા પુરૂષો પ્રત્યય -ette અથવા અન્ય પ્રત્યયનો ઉપયોગ કરે છે.",
            "guMT": true
          },
          "examples": [
            {
              "en": "usher → usherette; hero → heroine; executor → executrix",
              "gu": "usher → usherette; હીરો → નાયિકા; એક્ઝિક્યુટર → એક્ઝિક્યુટ્રીક્સ",
              "guMT": true
            }
          ]
        },
        {
          "text": {
            "en": "Some masculine and feminine forms are completely different words — these must be learnt separately.",
            "gu": "કેટલાક પુરૂષવાચી અને સ્ત્રીની સ્વરૂપો સંપૂર્ણપણે અલગ શબ્દો છે - આ અલગથી શીખવા જોઈએ.",
            "guMT": true
          },
          "examples": [
            {
              "en": "king → queen; bachelor → spinster; sir → madam; nephew → niece; bridegroom → bride; wizard → witch; duke → duchess",
              "gu": "રાજા → રાણી; સ્નાતક → સ્પિનસ્ટર; સર → મેડમ; ભત્રીજો → ભત્રીજી; વરરાજા → કન્યા; વિઝાર્ડ → ચૂડેલ; ડ્યુક → ડચેસ",
              "guMT": true
            }
          ]
        }
      ]
    }
