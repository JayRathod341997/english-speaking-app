  "title": {
    "en": "Tenses",
    "gu": "કાળ",
    "guMT": true
  },
  "summary": {
    "en": "The three time-frames (present, past, future) each split into four aspects (simple, continuous, perfect, perfect continuous) — how to form, question and negate each of the twelve tenses.",
    "gu": "ત્રણ સમય-ફ્રેમ્સ (વર્તમાન, ભૂતકાળ, ભવિષ્ય) દરેક ચાર પાસાઓમાં વિભાજિત થાય છે (સરળ, સતત, સંપૂર્ણ, સંપૂર્ણ સતત) - કેવી રીતે રચના કરવી, પ્રશ્ન કરવો અને બાર કાળમાંથી દરેકને નકારી શકાય.",
    "guMT": true
  },
  "sources": [
    "motion"
  ],
  "explanations": [
    {
      "block": "prose",
      "id": "ch-11-tenses/exp-1",
      "text": {
        "en": "A tense shows when an action happens. English has three time-frames — present, past and future — each with four aspects, giving twelve tenses in total. The key signal words (time adverbs) tell you which tense to use.",
        "gu": "જ્યારે ક્રિયા થાય છે ત્યારે તંગ દર્શાવે છે. અંગ્રેજીમાં ત્રણ સમય-ફ્રેમ છે — વર્તમાન, ભૂતકાળ અને ભવિષ્ય — દરેક ચાર પાસાઓ સાથે, કુલ બાર સમય આપે છે. મુખ્ય સંકેત શબ્દો (સમય ક્રિયાવિશેષણ) તમને જણાવે છે કે કયો સમય વાપરવો.",
        "guMT": true
      }
    },
    {
      "block": "table",
      "id": "ch-11-tenses/exp-2",
      "caption": {
        "en": "The twelve tenses — formula and signal words",
        "gu": "બાર સમય - સૂત્ર અને સંકેત શબ્દો",
        "guMT": true
      },
      "headers": [
        {
          "key": "tense",
          "label": {
            "en": "Tense",
            "gu": "તંગ",
            "guMT": true
          }
        },
        {
          "key": "formula",
          "label": {
            "en": "Formula",
            "gu": "ફોર્મ્યુલા",
            "guMT": true
          }
        },
        {
          "key": "signals",
          "label": {
            "en": "Signal words",
            "gu": "સંકેત શબ્દો",
            "guMT": true
          }
        }
      ],
      "rows": [
        {
          "tense": "Simple Present",
          "formula": "Subject + V1 (he/she/it: +s/es)",
          "signals": "always, daily, often, usually, every day"
        },
        {
          "tense": "Present Continuous",
          "formula": "Subject + am/is/are + V-ing",
          "signals": "now, at present, at this moment"
        },
        {
          "tense": "Present Perfect",
          "formula": "Subject + have/has + V3",
          "signals": "already, just now, ever, never, yet"
        },
        {
          "tense": "Present Perfect Continuous",
          "formula": "Subject + have/has been + V-ing + since/for",
          "signals": "since, for"
        },
        {
          "tense": "Simple Past",
          "formula": "Subject + V2",
          "signals": "yesterday, last week, ago, last year"
        },
        {
          "tense": "Past Continuous",
          "formula": "Subject + was/were + V-ing",
          "signals": "at 7 o'clock (past time), while"
        },
        {
          "tense": "Past Perfect",
          "formula": "Subject + had + V3",
          "signals": "before, after, when (past event completed earlier)"
        },
        {
          "tense": "Past Perfect Continuous",
          "formula": "Subject + had been + V-ing + since/for",
          "signals": "since, for (in a past context)"
        },
        {
          "tense": "Simple Future",
          "formula": "Subject + shall/will + V1",
          "signals": "tomorrow, next week, next year"
        },
        {
          "tense": "Future Continuous",
          "formula": "Subject + shall/will be + V-ing",
          "signals": "at this time tomorrow"
        },
        {
          "tense": "Future Perfect",
          "formula": "Subject + shall/will have + V3",
          "signals": "by (a future time)"
        },
        {
          "tense": "Future Perfect Continuous",
          "formula": "Subject + shall/will have been + V-ing",
          "signals": "by (future) + for/since"
        }
      ]
    },
    {
      "block": "rules",
      "id": "ch-11-tenses/exp-3",
      "title": {
        "en": "Simple Present — key rules",
        "gu": "સરળ વર્તમાન — મુખ્ય નિયમો",
        "guMT": true
      },
      "items": [
        {
          "text": {
            "en": "Add -s or -es to the base verb when the subject is he, she or it.",
            "gu": "જ્યારે વિષય he, she અથવા it હોય ત્યારે મૂળ ક્રિયાપદમાં -s અથવા -es ઉમેરો.",
            "guMT": true
          },
          "examples": [
            {
              "en": "He reads every day. She washes clothes. The bird flies.",
              "gu": "તે દરરોજ વાંચે છે. તે કપડાં ધોવે છે. પક્ષી ઉડે છે.",
              "guMT": true
            }
          ]
        },
        {
          "text": {
            "en": "Use 'Do' for questions with I/we/you/they; 'Does' for he/she/it.",
            "gu": "હું/અમે/તમે/તેઓ સાથેના પ્રશ્નો માટે 'ડુ' નો ઉપયોગ કરો; તે/તેણી/તે માટે 'કરે છે'.",
            "guMT": true
          },
          "examples": [
            {
              "en": "Do you play cricket? Does she read an English paper?",
              "gu": "શું તમે ક્રિકેટ રમો છો? શું તે અંગ્રેજી પેપર વાંચે છે?",
              "guMT": true
            }
          ]
        },
        {
          "text": {
            "en": "Use 'do not' / 'does not' for negatives. With 'does not', remove -s/-es from the verb.",
            "gu": "નકારાત્મક માટે 'do not' / 'does not' નો ઉપયોગ કરો. 'does not' સાથે, ક્રિયાપદમાંથી -s/-es કાઢી નાખો.",
            "guMT": true
          },
          "examples": [
            {
              "en": "I do not listen. He does not like maths.",
              "gu": "હું સાંભળતો નથી. તેને ગણિત પસંદ નથી.",
              "guMT": true
            }
          ]
        }
      ]
    },
    {
      "block": "rules",
      "id": "ch-11-tenses/exp-4",
      "title": {
        "en": "Simple Past — key rules",
        "gu": "સરળ ભૂતકાળ — મુખ્ય નિયમો",
        "guMT": true
      },
      "items": [
        {
          "text": {
            "en": "Use V2 (past form) for all subjects — no agreement needed.",
            "gu": "બધા વિષયો માટે V2 (પાસ્ટ ફોર્મ) નો ઉપયોગ કરો — કોઈ કરારની જરૂર નથી.",
            "guMT": true
          },
          "examples": [
            {
              "en": "I bought this T-shirt yesterday. She married last year.",
              "gu": "મેં ગઈકાલે આ ટી-શર્ટ ખરીદ્યું હતું. તેણીએ ગયા વર્ષે લગ્ન કર્યા હતા.",
              "guMT": true
            }
          ]
        },
        {
          "text": {
            "en": "Use 'Did' for questions; 'did not' for negatives; the main verb goes back to base form.",
            "gu": "પ્રશ્નો માટે 'Did' નો ઉપયોગ કરો; નકારાત્મક માટે 'નહીં'; મુખ્ય ક્રિયાપદ પાયાના સ્વરૂપમાં પાછું જાય છે.",
            "guMT": true
          },
          "examples": [
            {
              "en": "Did you pass the exam? We did not play on Sunday.",
              "gu": "શું તમે પરીક્ષા પાસ કરી? અમે રવિવારે રમ્યા ન હતા.",
              "guMT": true
            }
          ]
        }
      ]
    },
    {
      "block": "rules",
      "id": "ch-11-tenses/exp-5",
      "title": {
        "en": "Present Continuous — key rules",
        "gu": "વર્તમાન સતત — મુખ્ય નિયમો",
        "guMT": true
      },
      "items": [
        {
          "text": {
            "en": "Use am/is/are + verb-ing. If the verb ends in -e, drop the -e before -ing. Short vowel + consonant: double the consonant.",
            "gu": "am/is/are + ક્રિયાપદ-ing નો ઉપયોગ કરો. જો ક્રિયાપદ -e માં સમાપ્ત થાય છે, તો -ing પહેલાં -e મૂકો. લઘુ સ્વર + વ્યંજન: વ્યંજન બમણું.",
            "guMT": true
          },
          "examples": [
            {
              "en": "I am reading. Listen, Roopa is crying. They are buying ice cream.",
              "gu": "હું વાંચું છું. સાંભળો, રૂપા રડી રહી છે. તેઓ આઈસ્ક્રીમ ખરીદે છે.",
              "guMT": true
            }
          ]
        }
      ]
    }
  ],
