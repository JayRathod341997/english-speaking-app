    {
      "block": "rules",
      "id": "ch-08-to-be/exp-3",
      "title": {
        "en": "Making questions and negatives",
        "gu": "પ્રશ્નો અને નકારાત્મક બનાવો",
        "guMT": true
      },
      "items": [
        {
          "text": {
            "en": "To make a question, move the 'to be' verb before the subject.",
            "gu": "પ્રશ્ન બનાવવા માટે, વિષય પહેલા 'to be' ક્રિયાપદને ખસેડો.",
            "guMT": true
          },
          "examples": [
            {
              "en": "This sentence is false. → Is this sentence false?",
              "gu": "આ વાક્ય ખોટું છે. → શું આ વાક્ય ખોટું છે?",
              "guMT": true
            },
            {
              "en": "The lunch was delicious. → Was the lunch delicious?",
              "gu": "બપોરનું ભોજન સ્વાદિષ્ટ હતું. → શું બપોરનું ભોજન સ્વાદિષ્ટ હતું?",
              "guMT": true
            }
          ]
        },
        {
          "text": {
            "en": "To make a negative, add 'not' after the 'to be' verb.",
            "gu": "નકારાત્મક બનાવવા માટે, 'to be' ક્રિયાપદ પછી 'not' ઉમેરો.",
            "guMT": true
          },
          "examples": [
            {
              "en": "Pintu is fat. → Pintu is not fat.",
              "gu": "પિન્ટુ જાડો છે. → પિન્ટુ જાડો નથી.",
              "guMT": true
            },
            {
              "en": "It was difficult. → It was not difficult.",
              "gu": "તે મુશ્કેલ હતું. → તે મુશ્કેલ ન હતું.",
              "guMT": true
            }
          ]
        }
      ]
    },
