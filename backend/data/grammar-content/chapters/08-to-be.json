  "explanations": [
    {
      "block": "prose",
      "id": "ch-08-to-be/exp-1",
      "text": {
        "en": "The verb 'to be' is the most common verb in English. It is used to describe states, identities, qualities and positions. Its forms change depending on the subject (person) and time (tense).",
        "gu": "ક્રિયાપદ 'to be' અંગ્રેજીમાં સૌથી સામાન્ય ક્રિયાપદ છે. તેનો ઉપયોગ રાજ્યો, ઓળખ, ગુણો અને સ્થિતિનું વર્ણન કરવા માટે થાય છે. તેના સ્વરૂપો વિષય (વ્યક્તિ) અને સમય (તંગ) ના આધારે બદલાય છે.",
        "guMT": true
      }
    },
