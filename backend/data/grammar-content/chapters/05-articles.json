{
  "id": "ch-05-articles",
  "slug": "articles",
  "order": 5,
  "title": {
    "en": "Articles",
    "gu": "લેખો",
    "guMT": true
  },
  "summary": {
    "en": "How to use the articles a, an and the — and when to use no article at all.",
    "gu": "લેખ a, an અને the — નો ઉપયોગ કેવી રીતે કરવો અને કોઈ પણ લેખનો ઉપયોગ ક્યારે ન કરવો.",
    "guMT": true
  },
  "sources": [
    "motion",
    "anamika"
  ],
  "explanations": [
    {
      "block": "prose",
      "id": "ch-05-articles/exp-1",
      "text": {
        "en": "An article is a word placed before a noun to show whether the noun is general or specific. There are two kinds: the indefinite articles 'a' and 'an', and the definite article 'the'.",
        "gu": "લેખ એ સંજ્ઞા સામાન્ય છે કે વિશિષ્ટ છે તે દર્શાવવા માટે સંજ્ઞાની આગળ મૂકવામાં આવેલો શબ્દ છે. ત્યાં બે પ્રકાર છે: અનિશ્ચિત લેખ 'a' અને 'an', અને ચોક્કસ લેખ 'the'.",
        "guMT": true
      }
    },
    {
      "block": "rules",
      "id": "ch-05-articles/exp-2",
      "title": {
        "en": "Using 'a' and 'an'",
        "gu": "'a' અને 'an' નો ઉપયોગ",
        "guMT": true
      },
      "items": [
        {
          "text": {
            "en": "Use 'a' before a word that begins with a consonant sound.",
            "gu": "વ્યંજન ધ્વનિથી શરૂ થતા શબ્દ પહેલા 'a' નો ઉપયોગ કરો.",
            "guMT": true
          },
          "examples": [
            {
              "en": "a boy",
              "gu": "એક છોકરો",
              "guMT": true
            },
            {
              "en": "a book",
              "gu": "એક પુસ્તક",
              "guMT": true
            },
            {
              "en": "a university (sounds like 'yoo')",
              "gu": "યુનિવર્સિટી ('yoo' જેવું લાગે છે)",
              "guMT": true
            },
            {
              "en": "a one-day match (sounds like 'wun')",
              "gu": "વન-ડે મેચ ('વુન' જેવું લાગે છે)",
              "guMT": true
            }
          ]
        },
        {
          "text": {
            "en": "Use 'an' before a word that begins with a vowel sound (a, e, i, o, u).",
            "gu": "સ્વર ધ્વનિ (a, e, i, o, u) થી શરૂ થતા શબ્દ પહેલાં 'an' નો ઉપયોગ કરો.",
            "guMT": true
          },
          "examples": [
            {
              "en": "an apple",
              "gu": "એક સફરજન",
              "guMT": true
            },
            {
              "en": "an elephant",
              "gu": "એક હાથી",
              "guMT": true
            },
            {
              "en": "an honest man (the 'h' is silent)",
              "gu": "પ્રામાણિક માણસ ('એચ' મૌન છે)",
              "guMT": true
            },
            {
              "en": "an hour (the 'h' is silent)",
              "gu": "એક કલાક ('h' શાંત છે)",
              "guMT": true
            },
            {
              "en": "an M.A. (sounds like 'em')",
              "gu": "એક M.A. ('એમ' જેવું લાગે છે)",
              "guMT": true
            }
          ]
        },
        {
          "text": {
            "en": "Remember it is the sound, not the spelling, that decides between 'a' and 'an'.",
            "gu": "યાદ રાખો કે તે ધ્વનિ છે, જોડણી નથી, જે 'a' અને 'an' વચ્ચે નક્કી કરે છે.",
            "guMT": true
          }
        }
      ]
    },
    {
      "block": "rules",
      "id": "ch-05-articles/exp-3",
      "title": {
        "en": "Using 'the'",
        "gu": "'the' નો ઉપયોગ કરીને",
        "guMT": true
      },
      "items": [
        {
          "text": {
            "en": "Use 'the' for unique things — there is only one of them.",
            "gu": "અનન્ય વસ્તુઓ માટે 'the' નો ઉપયોગ કરો - તેમાંથી ફક્ત એક જ છે.",
            "guMT": true
          },
          "examples": [
            {
              "en": "the Sun",
              "gu": "સૂર્ય",
              "guMT": true
            },
            {
              "en": "the Moon",
              "gu": "ચંદ્ર",
              "guMT": true
            },
            {
              "en": "the Earth",
              "gu": "પૃથ્વી",
              "guMT": true
            },
            {
              "en": "the sky",
              "gu": "આકાશ",
              "guMT": true
            }
          ]
        },
        {
          "text": {
            "en": "Use 'the' before the names of rivers, mountain ranges, holy books and oceans.",
            "gu": "નદીઓ, પર્વતમાળાઓ, પવિત્ર પુસ્તકો અને મહાસાગરોના નામ પહેલાં 'the' નો ઉપયોગ કરો.",
            "guMT": true
          },
          "examples": [
            {
              "en": "the Ganga",
              "gu": "ગંગા",
              "guMT": true
            },
            {
              "en": "the Himalayas",
              "gu": "હિમાલય",
              "guMT": true
            },
            {
              "en": "the Ramayana",
              "gu": "રામાયણ",
              "guMT": true
            },
            {
              "en": "the Indian Ocean",
              "gu": "હિંદ મહાસાગર",
              "guMT": true
            }
          ]
        },
        {
          "text": {
            "en": "Use 'the' before a superlative degree.",
            "gu": "શ્રેષ્ઠ ડિગ્રી પહેલાં 'the' નો ઉપયોગ કરો.",
            "guMT": true
          },
          "examples": [
            {
              "en": "the tallest",
              "gu": "સૌથી ઊંચું",
              "guMT": true
            },
            {
              "en": "the most intelligent",
              "gu": "સૌથી બુદ્ધિશાળી",
              "guMT": true
            },
            {
              "en": "the longest",
              "gu": "સૌથી લાંબુ",
              "guMT": true
            }
          ]
        },
        {
          "text": {
            "en": "Use 'the' when a noun is mentioned a second time (it is now specific).",
            "gu": "જ્યારે સંજ્ઞાનો બીજી વખત ઉલ્લેખ કરવામાં આવે ત્યારે 'the' નો ઉપયોગ કરો (તે હવે ચોક્કસ છે).",
            "guMT": true
          },
          "examples": [
            {
              "en": "There is a cow in the garden. The cow is grazing.",
              "gu": "બગીચામાં એક ગાય છે. ગાય ચરતી હોય છે.",
              "guMT": true
            }
          ]
        }
      ]
    },
    {
