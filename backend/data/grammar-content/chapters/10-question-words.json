    {
      "block": "rules",
      "id": "ch-10-question-words/exp-2",
      "title": {
        "en": "Who vs Whom",
        "gu": "કોણ વિ કોને",
        "guMT": true
      },
      "items": [
        {
          "text": {
            "en": "'Who' is the subject — it does the action.",
            "gu": "'કોણ' વિષય છે - તે ક્રિયા કરે છે.",
            "guMT": true
          },
          "examples": [
            {
              "en": "Who broke the glass? (Who = subject)",
              "gu": "કાચ કોણે તોડ્યો? (કોણ = વિષય)",
              "guMT": true
            }
          ]
        },
        {
          "text": {
            "en": "'Whom' is the object — it receives the action.",
            "gu": "'કોણ' પદાર્થ છે - તે ક્રિયા પ્રાપ્ત કરે છે.",
            "guMT": true
          },
          "examples": [
            {
              "en": "Whom do you love? (you = subject, whom = object)",
              "gu": "તમે કોને પ્રેમ કરો છો? (તમે = વિષય, કોને = પદાર્થ)",
              "guMT": true
            }
          ]
        }
      ]
    },
    {
      "block": "rules",
      "id": "ch-10-question-words/exp-3",
      "title": {
        "en": "Why, How, When, Which — detailed usage",
        "gu": "શા માટે, કેવી રીતે, ક્યારે, કયો — વિગતવાર ઉપયોગ",
        "guMT": true
      },
      "items": [
        {
          "text": {
            "en": "'Why' asks for a reason. The answer usually starts with 'because'.",
            "gu": "'કેમ' કારણ પૂછે છે. જવાબ સામાન્ય રીતે 'કારણ' થી શરૂ થાય છે.",
            "guMT": true
          },
          "examples": [
            {
              "en": "Why are you crying? — Because I fell down. | Why did she leave early? | Why is this door locked?",
              "gu": "કેમ રડે છે? - કારણ કે હું નીચે પડી ગયો. | તેણી શા માટે વહેલી નીકળી ગઈ? | આ દરવાજો કેમ બંધ છે?",
              "guMT": true
            }
          ]
        },
        {
          "text": {
            "en": "'How' asks about manner, condition or method.",
            "gu": "'કેવી રીતે' રીત, સ્થિતિ અથવા પદ્ધતિ વિશે પૂછે છે.",
            "guMT": true
          },
          "examples": [
            {
              "en": "How are you? | How did you travel to Mumbai? | How do you spell this word?",
              "gu": "તમે કેમ છો? | તમે મુંબઈની મુસાફરી કેવી રીતે કરી? | તમે આ શબ્દની જોડણી કેવી રીતે કરશો?",
              "guMT": true
            }
          ]
        },
        {
          "text": {
            "en": "'When' asks about time.",
            "gu": "'જ્યારે' સમય વિશે પૂછે છે.",
            "guMT": true
          },
          "examples": [
            {
              "en": "When is your birthday? | When did the train arrive? | When will the results come?",
              "gu": "તમારો જન્મદિવસ ક્યારે છે? | ટ્રેન ક્યારે આવી? | પરિણામો ક્યારે આવશે?",
              "guMT": true
            }
          ]
        },
        {
          "text": {
            "en": "'Which' asks for a choice from a known, specific set.",
            "gu": "'જે' જાણીતા, ચોક્કસ સમૂહમાંથી પસંદગી માટે પૂછે છે.",
            "guMT": true
          },
          "examples": [
            {
              "en": "Which is our national bird? | Which book did you buy? | Which team won the match?",
              "gu": "આપણું રાષ્ટ્રીય પક્ષી કયું છે? | તમે કયું પુસ્તક ખરીદ્યું? | કઈ ટીમ મેચ જીતી?",
              "guMT": true
            }
          ]
        }
      ]
    },
