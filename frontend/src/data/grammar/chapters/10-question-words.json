      "options": [
        {
          "id": "a",
          "text": {
            "en": "Who",
            "gu": "WHO",
            "guMT": true
          }
        },
        {
          "id": "b",
          "text": {
            "en": "Whom",
            "gu": "કોને",
            "guMT": true
          }
        },
        {
          "id": "c",
          "text": {
            "en": "Whose",
            "gu": "જેની",
            "guMT": true
