      "rows": [
        {
          "verb": "Get",
          "when": "persuading / convincing someone",
          "active": "Subject + get + person + to + V1",
          "passive": "Subject + get + object + V3"
        },
        {
          "verb": "Make",
          "when": "forcing someone to do something",
          "active": "Subject + make + person + V1 (no 'to')",
          "passive": "N/A (make passive not common)"
        },
        {
          "verb": "Have",
          "when": "arranging for a service to be done",
          "active": "Subject + have + person + V1",
          "passive": "Subject + have + object + V3"
        }
      ]
