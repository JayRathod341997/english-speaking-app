      "items": [
        {
          "en": "Get AV: Some pupils get their parents to do their homework.",
          "gu": "AV મેળવો: કેટલાક વિદ્યાર્થીઓ તેમના માતા-પિતાને તેમનું હોમવર્ક કરાવે છે.",
          "guMT": true
        },
        {
          "en": "Get PV: I got this application written by my teacher.",
          "gu": "PV મેળવો: મને આ અરજી મારા શિક્ષક દ્વારા લખવામાં આવી છે.",
          "guMT": true
        },
        {
          "en": "Make AV: She makes her husband clean the home.",
          "gu": "AV બનાવો: તેણી તેના પતિને ઘર સાફ કરાવે છે.",
          "guMT": true
