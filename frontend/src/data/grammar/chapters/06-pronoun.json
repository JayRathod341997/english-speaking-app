    {
      "block": "rules",
      "id": "ch-06-pronoun/exp-4",
      "title": {
        "en": "Relative pronouns: who, whom, whose, which",
        "gu": "સંબંધિત સર્વનામ: who, whom, who, who",
        "guMT": true
      },
      "items": [
        {
          "text": {
            "en": "Use 'who' for the subject when talking about people.",
            "gu": "લોકો વિશે વાત કરતી વખતે વિષય માટે 'કોણ' નો ઉપયોગ કરો.",
            "guMT": true
          },
          "examples": [
            {
              "en": "The man who talks too much is seldom respected.",
              "gu": "જે માણસ વધારે બોલે છે તેને ભાગ્યે જ માન આપવામાં આવે છે.",
              "guMT": true
            }
          ]
        },
        {
          "text": {
            "en": "Use 'whom' for the object when talking about people.",
            "gu": "લોકો વિશે વાત કરતી વખતે ઑબ્જેક્ટ માટે 'કોને' નો ઉપયોગ કરો.",
            "guMT": true
          },
          "examples": [
            {
              "en": "The girl whom I met yesterday was very clever.",
              "gu": "ગઈ કાલે હું જે છોકરીને મળ્યો હતો તે ખૂબ જ હોંશિયાર હતી.",
              "guMT": true
            }
          ]
        },
        {
          "text": {
            "en": "Use 'whose' to show possession.",
            "gu": "કબજો બતાવવા માટે 'કોના' નો ઉપયોગ કરો.",
            "guMT": true
          },
          "examples": [
            {
              "en": "M. F. Hussain was an artist whose paintings became popular.",
              "gu": "એમ.એફ. હુસૈન એવા કલાકાર હતા જેમના ચિત્રો લોકપ્રિય થયા હતા.",
              "guMT": true
            }
          ]
        },
        {
          "text": {
            "en": "Use 'which' for things and animals.",
            "gu": "વસ્તુઓ અને પ્રાણીઓ માટે 'જે' નો ઉપયોગ કરો.",
            "guMT": true
          },
          "examples": [
            {
              "en": "The time which is lost, is lost forever.",
              "gu": "જે સમય ખોવાઈ જાય છે, તે કાયમ માટે ખોવાઈ જાય છે.",
              "guMT": true
            }
          ]
        }
      ]
    },
    {
