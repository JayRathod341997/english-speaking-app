      },
      "items": [
        {
          "text": {
            "en": "'According to' — following rules/information of.",
            "gu": "'અનુસાર' — નીચેના નિયમો/માહિતી.",
            "guMT": true
          },
          "examples": [
            {
              "en": "I always work according to my father's advice.",
              "gu": "હું હંમેશા મારા પિતાની સલાહ મુજબ કામ કરું છું.",
              "guMT": true
            }
          ]
        },
        {
          "text": {
            "en": "'Because of / On account of / Owing to' — due to.",
            "gu": "'કારણ કે/ના કારણે/ને કારણે' — કારણે.",
            "guMT": true
          },
          "examples": [
            {
              "en": "She left her job because of her family problem.",
              "gu": "પારિવારિક સમસ્યાને કારણે તેણે નોકરી છોડી દીધી હતી.",
              "guMT": true
            }
          ]
        },
        {
          "text": {
            "en": "'In spite of / Despite' — regardless of.",
            "gu": "' હોવા છતાં / હોવા છતાં' — અનુલક્ષીને.",
            "guMT": true
          },
          "examples": [
            {
              "en": "In spite of all his efforts, he could not pass.",
              "gu": "તેના તમામ પ્રયાસો છતાં તે પાસ ન થઈ શક્યો.",
              "guMT": true
            }
          ]
        },
        {
          "text": {
            "en": "'In order to / With a view to (+ing)' — for the purpose of.",
            "gu": "'(+ing) ની દૃષ્ટિએ / સાથે' — હેતુ માટે.",
            "guMT": true
          },
          "examples": [
            {
              "en": "Many people go abroad in order to earn money.",
              "gu": "ઘણા લોકો પૈસા કમાવવા માટે વિદેશ જાય છે.",
              "guMT": true
            }
          ]
        }
      ]
    }
