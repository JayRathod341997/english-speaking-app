  "summary": {
    "en": "Words placed before a noun or pronoun to show its relationship with another word — covering position (on, over, under, in, beside), direction, time, and phrase prepositions.",
    "gu": "અન્ય શબ્દ સાથેનો સંબંધ દર્શાવવા માટે સંજ્ઞા અથવા સર્વનામ પહેલાં મૂકવામાં આવેલા શબ્દો — કવરિંગ પોઝિશન (ચાલુ, ઉપર, નીચે, અંદર, બાજુમાં), દિશા, સમય અને શબ્દસમૂહ પૂર્વનિર્ધારણ.",
    "guMT": true
  },
  "sources": [
    "motion"
  ],
  "explanations": [
    {
      "block": "prose",
      "id": "ch-12-prepositions/exp-1",
      "text": {
        "en": "A preposition is a word placed before a noun or pronoun to show its relationship (position, direction, time, manner, etc.) with another part of the sentence.",
        "gu": "પૂર્વનિર્ધારણ એ વાક્યના અન્ય ભાગ સાથે તેનો સંબંધ (સ્થિતિ, દિશા, સમય, રીત, વગેરે) બતાવવા માટે સંજ્ઞા અથવા સર્વનામ પહેલાં મૂકવામાં આવેલો શબ્દ છે.",
        "guMT": true
      }
    },
    {
